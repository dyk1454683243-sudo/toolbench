{
  "name": "toolbench-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "node --test \"packages/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "typecheck": "tsc -b packages/sdk packages/runtime && tsc --noEmit -p tools/tsconfig.json",
    "bench": "pnpm --filter @toolbench/bench dev",
    "bench:build": "pnpm --filter @toolbench/bench build",
    "check": "pnpm typecheck && pnpm test",
    "test:bench": "node --test bench/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "playwright": "1.57.0"
  }
}
