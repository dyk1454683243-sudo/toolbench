{
  "name": "@toolbench/runtime",
  "version": "0.1.0",
  "description": "Renders and runs a Toolbench tool in any web page: a <tool-host> custom element with three display modes, no framework required.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/register.js"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./register": { "types": "./dist/register.d.ts", "default": "./dist/register.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" }
  },
  "files": ["dist"],
  "scripts": { "build": "tsc -b" },
  "dependencies": { "@toolbench/sdk": "workspace:*" }
}
