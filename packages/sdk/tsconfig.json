{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    /* No DOM on purpose — the SDK must run in plain Node, which is how tool fixtures run. Node's
       types supply AbortSignal, performance and timers without dragging in `document`. */
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
